# Copy to .env.local and fill in. Never commit real values.

# Google Gemini API key from https://aistudio.google.com/app/apikey (server-only secret).
# Leave blank to run Utsav in offline mode: the rule-based planner still produces
# complete budgets, timelines and checklists, and ideas fall back to curated suggestions.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite, the lowest-cost current Gemini model.
GEMINI_MODEL=

# Optional per-client, per-minute rate limits (defaults: 8 plans, 15 chat messages).
PLAN_RATE_LIMIT=
CHAT_RATE_LIMIT=
